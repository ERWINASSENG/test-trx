{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run full project tests",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test",
				"--",
				"--watch=false"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build production app",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Lint project",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run CI test command",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test",
				"--",
				"--watch=false",
				"--no-progress"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find access mutation SQL",
			"type": "shell",
			"command": "git",
			"args": [
				"--no-pager",
				"grep",
				"-n",
				"access_control_mutate"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find invalid SQL checks",
			"type": "shell",
			"command": "git",
			"args": [
				"--no-pager",
				"grep",
				"-n",
				"22023\\|invalid\\|unsupported\\|role.permissions.replace",
				"--",
				"supabase"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Locate deployed RPC versions",
			"type": "shell",
			"command": "git",
			"args": [
				"--no-pager",
				"grep",
				"-n",
				"Unsupported access-control operation",
				"--",
				"supabase"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}