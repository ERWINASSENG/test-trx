# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for Authentication & Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Clé secrète de service Supabase pour les opérations d'administration serveur (création d'utilisateurs avec mot de passe)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Liste des adresses emails autorisées comme administrateurs système permanents (séparées par une virgule)
ADMIN_EMAILS="admin@example.com"

# ==============================================================================
# RATE LIMITING & SÉCURITÉ DU SERVEUR
# ==============================================================================
# Fenêtre temporelle en millisecondes pour le rate limiting global (ex: 900000 = 15 minutes)
API_RATE_LIMIT_WINDOW_MS=900000

# Quota maximal de requêtes pour les utilisateurs anonymes / non authentifiés (par IP, défaut: 200)
API_RATE_LIMIT_MAX=200

# Quota maximal de requêtes pour les utilisateurs connectés avec jeton JWT valide (par compte utilisateur, défaut: 1200)
API_RATE_LIMIT_AUTH_MAX=1200

# Quota maximal sur les endpoints d'authentification et de configuration /api/auth/* (défaut: 120)
AUTH_SYNC_RATE_LIMIT_MAX=120

# Configuration facultative Upstash Redis (pour rate limiting distribué multi-instances en production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
