{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "ng build",
  "outputDirectory": "dist/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/mail-sync",
      "schedule": "0 7 * * *"
    }
  ]
}
